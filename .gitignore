# Claude session files
.claude/

# Xcode — user-specific, generated, not needed by others
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Loose files that shouldn't be tracked
Screenshots/
*.png
!Stlls/Assets.xcassets/**/*.png

# Environment / secrets — never commit these
.env
.env.*
secrets.*
*.pem
*.key
